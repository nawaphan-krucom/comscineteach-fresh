{
  "name": "computing-science-project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:e2e": "playwright test",
    "build:utils": "esbuild components/utils/gradebookExport.ts --outfile=components/utils/gradebookExport.js --bundle --platform=browser --format=esm",
    "check-env": "node ./scripts/check_env.cjs",
    "build": "npm run check-env && npm run build:utils && tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "vite",
    "test": "jest",
    "e2e:prepare": "node ./e2e/global-setup.cjs --ci-check",
    "test:reset-emulator": "node ./scripts/test_reset_user_password_emulator.cjs",
    "test:fn-smoke": "node ./scripts/test_send_reset_email_smoke.cjs",
    "check-sync": "node scripts/check_user_progress_sync.cjs",
    "fix-missing-progress": "node scripts/fix_create_missing_progress.cjs",
    "cleanup-orphan-progress": "node scripts/cleanup_orphan_progress.cjs"
  },
  "dependencies": {
    "@google/genai": "^1.33.0",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "dompurify": "^3.3.1",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "fuse.js": "^6.6.2",
    "lodash-es": "^4.17.23",
    "lucide-react": "^0.563.0",
    "minimist": "^1.2.8",
    "pdfkit": "^0.17.2",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.3",
    "react-player": "^2.16.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.4.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "framer-motion": "^12.28.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.35.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "ts-jest": "^29.4.6",
    "typescript": "^5.4.2",
    "vite": "^7.3.1",
    "yup": "^1.7.1"
  }
